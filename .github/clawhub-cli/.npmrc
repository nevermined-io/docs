# The ClawHub CLI runs in the job that holds CLAWHUB_TOKEN, so it stays pinned to
# one exact version and its whole tree is locked (nevermined-io/docs#647).
# save-exact keeps `npm i clawhub@<version>` from writing a `^` range. Every
# package in the lock must be at least 14 days old (check-age.sh); Dependabot's
# cooldown covers only the clawhub version, so after any bump, by hand or by
# Dependabot, re-resolve the tree with `--before=<date 14 days ago>` if that
# check fails, and commit the regenerated package-lock.json.
save-exact=true
