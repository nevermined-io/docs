# The ClawHub CLI runs in the job that holds CLAWHUB_TOKEN, so it stays pinned to
# one exact version and its whole tree is locked (nevermined-io/docs#647).
# save-exact keeps `npm i clawhub@<version>` from writing a `^` range. When you
# bump it by hand, resolve the tree with `--before=<date two weeks ago>` (the
# Dependabot cooldown) and commit the regenerated package-lock.json.
save-exact=true
